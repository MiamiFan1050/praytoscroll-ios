default_platform(:ios)

# Pray to Scroll: listing + submission with the App Store Connect API key (no Apple ID login).
#   cd ~/praypass && ASC_KEY_ID=U6Q28J57U5 ASC_ISSUER_ID=271a7b2c-4191-4c72-91fe-d4561462f7bf \
#     ASC_KEY_PATH=~/.appstoreconnect/private_keys/AuthKey_U6Q28J57U5.p8 fastlane ios store
#   ... fastlane ios store submit:true build:N   -> also select build N and submit for review
# The App Review contact (name / phone / email) is entered by Mark in App Store Connect, never here.
# App Privacy ("nutrition label") is web-only: see store/APP_PRIVACY.md.
platform :ios do
  def asc_key
    app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_filepath: File.expand_path(ENV.fetch("ASC_KEY_PATH")),
      in_house: false
    )
  end

  lane :store do |opts|
    submit = opts[:submit].to_s == "true"
    deliver(
      api_key: asc_key,
      app_identifier: "com.amenkeyapp.ios",
      app_version: (opts[:version] || "1.0").to_s,
      skip_binary_upload: true,
      metadata_path: "./store/metadata",
      screenshots_path: "./store/screenshots/final",
      overwrite_screenshots: true,
      app_rating_config_path: "./store/AGE_RATING.json",
      force: true,
      run_precheck_before_submit: false,
      precheck_include_in_app_purchases: false,
      submit_for_review: submit,
      build_number: submit ? opts[:build].to_s : nil,
      automatic_release: true,
      submission_information: {
        add_id_info_uses_idfa: false,
        content_rights_contains_third_party_content: false,
        export_compliance_uses_encryption: false
      }
    )
  end
end
